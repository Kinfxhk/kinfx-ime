# KINFX 速成 — 使用者覆寫例
# 複製到：~/.local/share/fcitx5/rime/kinfx_quick.custom.yaml
# 然後重新部署（F4 或 rime_deployer）。完整說明：docs/CONFIG.md
#
# 預設（schema）：全程零切換混打＝大寫拉丁／email／URL 直出，唔使切英文模式。
# 以下全部可改；唔改＝沿用 schema 預設。

patch:
  # ========== 混打策略 ==========
  # A) 零切換（預設）：大寫開頭英詞直出
  "recognizer/patterns/uppercase": "[A-Z][-_+.'0-9A-Za-z]*$"
  "recognizer/patterns/email": "^[A-Za-z][-_.0-9A-Za-z]*@.*$"
  "recognizer/patterns/url": "^(www[.]|https?:|ftp[.:]|mailto:|file:).*$|[a-z]+[.].+$"

  # B) 臨時西文鍵（可選；Fcitx5 預設 LShift 可能搶走）
  "ascii_composer/switch_key/Shift_L": inline_ascii   # 或 noop / commit_code / clear
  "ascii_composer/switch_key/Shift_R": commit_text
  "ascii_composer/switch_key/Caps_Lock": clear
  "ascii_composer/good_old_caps_lock": true

  # C) 持久中／西文開關鍵（預設 Control+Shift+2）
  # 若只要「必須切 ascii_mode 先打英文」，可將 uppercase pattern 清空並靠呢個 toggle：
  # "recognizer/patterns/uppercase": "^$"
  # "key_binder/bindings":
  #   - { when: always, accept: Control+Shift+2, toggle: ascii_mode }

  # ========== 候選／排序偏好 ==========
  # 產品預設 menu/page_size = 9（Windows 官方速成；選字鍵 1–9）。
  # 所有前端跟 schema，唔會自己改成 5。下面只係 Flex 示範：
  # 取消註解會偏離產品預設，第 6–9 位會睇唔到／選字鍵錯位。
  # "menu/page_size": 5
  "translator/enable_user_dict": true          # false = 測試／穩定排序（唔學頻）
  "translator/enable_completion": true
  "translator/enable_sentence": true
  "translator/max_phrase_length": 5

  # ========== 選字（預設＝Windows；取消註解即偏離）==========
  # 空白改回「選焦點候選」（v0.1.1 習慣；有候選窗時通常即第 1 個）。
  # 無候選窗（好API）空白仍然上屏。唔使改 key_binder 索引。
  # "win_quick/space_pages": false
  # "win_quick/hot_page": false          # 關掉常用熱門環頁
  # "win_quick/tab_expand": false        # Tab 唔再展開
  # "style/horizontal": true             # 打橫。Fcitx5 另設 classicui「Vertical Candidate List=False」
  # "editor/bindings/Return": commit_raw_input   # 還原 Enter 原樣上屏（會出 vd）

  # ========== 方案內其他 ==========
  # "speller/max_code_length": 2
  # "speller/auto_select": false
